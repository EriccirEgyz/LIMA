# IDE & Editor Files
.DS_Store
.cursor/
.vscode/

# Python
__pycache__/
*.egg-info/

# Environment & Secrets
.env

# Logs
*.log
/log*/

# Data & Checkpoints
/data*/
/checkpoint/
/models/

# Evaluation Outputs (BFCL, tau2-bench, etc. — large, regenerable)
/results/

# Libraries & Dependencies
/lib/

# Unmodified vendored eval clones — re-cloned by setup_*.sh (not committed)
/src/eval/gorilla/
/src/eval/tau2-bench/

# OmniaBench official harness — clean clone, re-clone via:
#   git clone git@github.com:scuuy/OmniaBench.git
# (its .venv and any local patches stay out of this repo)
/OmniaBench/

# Backup / one-off patch files (keep in working tree, not in history)
*.bak-*
*.fixA-*

# LLaMA-Factory & verl ARE committed as source (modified for this repro),
# but their weights / generated data / run artifacts are excluded:
LLaMA-Factory/models/
verl/data/env_factory_rl.json
**/log_rollout/
**/outputs/
**/tensorboard_log/
**/checkpoints/
*.safetensors
*.bin
*.pt
*.pth

# Virtualenvs & caches (never commit)
.venv/
.venv-sft/
.cache/

# Databases
*.db

# Serialized/Cache Files
*.pkl